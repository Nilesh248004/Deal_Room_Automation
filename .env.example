# Copy to .env and fill in. Never commit .env.

# --- API server ---
HOST=127.0.0.1
PORT=8790
# name:key[:role] entries, comma separated. Use long random keys (e.g. `openssl rand -hex 32`).
# Roles: viewer (read only) | operator (default: create, approve, edit, retry, cancel, roll back) | admin (also approves brand-asset rights).
# Example: API_KEYS=ops:<key1>,dashboard:<key2>:viewer,lead:<key3>:admin
API_KEYS=ops:XXX
MAX_CONCURRENT=2
DATA_DIR=data
# Optional: POST a JSON status update here on every job change (Slack workflow, etc.)
WEBHOOK_URL=

# --- Hippo (only needed for load=api) ---
HIPPO_BASE_URL=https://www.hippovideo.io
# Preferred: a service token from Hippo engineering
HIPPO_API_TOKEN=
# Interim only: a logged-in session cookie + CSRF token (expires; treat as a password)
HIPPO_COOKIE=
HIPPO_CSRF=
# Restore the backup automatically if the read-back check fails (1 = yes)
AUTO_ROLLBACK=1

# --- Optional AI copy polish (OpenAI-compatible endpoint; e.g. a free local Ollama: http://127.0.0.1:11434) ---
# Leave empty to use only the deterministic, sourced copy. AI output is rejected unless every number and name is in the hotel's own text.
LLM_BASE_URL=
LLM_MODEL=llama3.1
LLM_API_KEY=

# --- Safety ---
# Optional allowlist of hotel domains, comma separated (e.g. tajhotels.com,ihg.com,marriott.com)
ALLOWED_HOTEL_DOMAINS=
# Local testing only: allow http:// hotel pages
ALLOW_HTTP=
# Save a HAR of the capture (bigger job folders)
CAPTURE_HAR=

# --- Hotel-specific automation ---
# Respect robots.txt on the hotel's site: enforce | warn | off
ROBOTS_POLICY=enforce
# Photo checks (reachable, really an image, size, hash). enforce drops unusable photos; warn only records them; off skips (QA then asks for review)
ASSET_CHECK_POLICY=enforce
# require: mode=auto never publishes until an admin has approved the hotel's brand-asset rights (customization asset_rights). warn: allow, with a warning.
ASSET_RIGHTS_POLICY=require
ASSET_CACHE_HOURS=24
# Transient failures (network, 429, 5xx) retry with exponential backoff
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_MS=2000
RETRY_MAX_MS=60000
MAX_MANUAL_RETRIES=5
# An identical request returns the existing job while it is active, or this long after it succeeded
IDEMPOTENCY_WINDOW_HOURS=24
# Remove finished jobs older than this many days (0 = keep). Never removes active jobs, jobs with an open exception, or the hotel store.
RETENTION_DAYS=0
# Tests only: allow the pipeline to reach private/loopback addresses. Never set in production.
ALLOW_PRIVATE_HOSTS=
